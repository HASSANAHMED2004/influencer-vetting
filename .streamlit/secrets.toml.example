# Copy to .streamlit/secrets.toml for local use, OR paste these into
# Streamlit Cloud → your app → Settings → Secrets. Never commit the real file.

YOUTUBE_API_KEY = "your-youtube-data-api-key"
SCRAPECREATORS_API_KEY = "your-scrapecreators-key"

# Shared password your friend types to access the app. Remove/leave blank to
# disable the gate (only safe when access is already restricted another way).
APP_PASSWORD = "pick-something-only-you-two-know"
