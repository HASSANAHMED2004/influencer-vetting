# Copy to .env and fill in. .env is gitignored — never commit real keys.

# YouTube Data API v3 key (free — https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# ScrapeCreators API key (paid — https://scrapecreators.com). Optional:
# if unset, the Instagram/TikTok steps are skipped and marked "not-checked".
SCRAPECREATORS_API_KEY=

# --- Bright Data (LinkedIn) --------------------------------------------------
# LinkedIn profile followers via Bright Data (ScrapeCreators is ~89% blind on LinkedIn).
# Token: brightdata.com -> Account settings -> API tokens.
BRIGHTDATA_API_TOKEN=
# Dataset id for the LinkedIn "Profiles" (people) scraper (gd_xxxxxxxx).
# Web Scrapers -> LinkedIn -> Profiles. Leave blank to use the documented default.
BRIGHTDATA_DATASET_ID=
